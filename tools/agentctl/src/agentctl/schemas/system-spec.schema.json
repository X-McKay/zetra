{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playbooks.example/schemas/system-spec.schema.json",
  "title": "Multi-Agent System Spec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "description",
    "metadata",
    "justification",
    "topology",
    "members",
    "interactions",
    "limits",
    "state",
    "termination"
  ],
  "properties": {
    "name": { "$ref": "#/$defs/name" },
    "description": { "type": "string", "minLength": 1 },
    "metadata": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "contract_version",
        "owner",
        "operational_owner",
        "version",
        "execution_class",
        "governance_tier",
        "risk_assessment",
        "threat_model",
        "evaluation_policy",
        "data_classification",
        "temporal_enabled"
      ],
      "properties": {
        "contract_version": { "type": "integer", "minimum": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "operational_owner": { "type": "string", "minLength": 1 },
        "version": { "$ref": "#/$defs/semver" },
        "execution_class": { "$ref": "#/$defs/executionClass" },
        "governance_tier": { "$ref": "#/$defs/tier" },
        "risk_assessment": { "type": "string", "minLength": 1 },
        "threat_model": { "type": "string", "minLength": 1 },
        "evaluation_policy": { "type": "string", "minLength": 1 },
        "data_classification": { "type": "string", "minLength": 1 },
        "temporal_enabled": { "type": "boolean" },
        "approval_policy": { "type": "string", "minLength": 1 }
      }
    },
    "justification": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "claimed_benefits",
        "baseline",
        "success_measures"
      ],
      "properties": {
        "decision_owner": { "type": "string", "minLength": 1 },
        "review_by": { "type": "string", "format": "date" },
        "claimed_benefits": { "$ref": "#/$defs/nonemptyStrings" },
        "baseline": { "type": "string", "minLength": 1 },
        "evidence": { "type": "string", "minLength": 1 },
        "success_measures": { "$ref": "#/$defs/nonemptyStrings" }
      }
    },
    "topology": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "type",
        "orchestrator",
        "dynamic_membership",
        "recursive_delegation"
      ],
      "properties": {
        "type": {
          "enum": [
            "programmatic_pipeline",
            "supervisor_worker",
            "fanout_gather",
            "producer_reviewer",
            "handoff",
            "quorum",
            "hierarchical",
            "blackboard",
            "peer_mesh",
            "recursive_task_tree",
            "dynamic_membership",
            "market",
            "event_driven",
            "hybrid"
          ]
        },
        "orchestrator": { "$ref": "#/$defs/name" },
        "coordinator": { "type": ["string", "null"], "minLength": 1 },
        "dynamic_membership": { "type": "boolean" },
        "recursive_delegation": { "type": "boolean" },
        "registry": { "type": "string", "minLength": 1 },
        "admission_policy": { "type": "string", "minLength": 1 },
        "aggregation_policy": { "type": "string", "minLength": 1 },
        "conflict_policy": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": {
            "properties": { "dynamic_membership": { "const": true } },
            "required": ["dynamic_membership"]
          },
          "then": { "required": ["registry", "admission_policy"] }
        }
      ]
    },
    "members": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/member" }
    },
    "interactions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/interaction" }
    },
    "limits": { "$ref": "#/$defs/limits" },
    "state": {
      "type": "object",
      "additionalProperties": true,
      "required": ["owner", "shared_memory", "artifact_policy"],
      "properties": {
        "owner": { "$ref": "#/$defs/name" },
        "shared_memory": { "type": "string", "minLength": 1 },
        "artifact_policy": { "type": "string", "minLength": 1 },
        "conflict_policy": { "type": "string", "minLength": 1 }
      }
    },
    "termination": {
      "type": "object",
      "additionalProperties": true,
      "required": ["policy", "success_states", "escalation_state"],
      "properties": {
        "policy": { "type": "string", "minLength": 1 },
        "success_states": { "$ref": "#/$defs/nonemptyStrings" },
        "escalation_state": { "type": "string", "minLength": 1 }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "metadata": {
            "properties": { "execution_class": { "const": "human_governed" } },
            "required": ["execution_class"]
          }
        }
      },
      "then": {
        "properties": {
          "metadata": { "required": ["approval_policy"] }
        }
      }
    }
  ],
  "$defs": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "semver": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "executionClass": {
      "enum": ["ephemeral", "durable", "human_governed"]
    },
    "tier": {
      "enum": ["low", "medium", "high", "critical"]
    },
    "nonemptyStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "restrictions": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "skills": {
          "type": "object",
          "additionalProperties": false,
          "required": ["include"],
          "properties": {
            "include": {
              "type": "array",
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/name" }
            }
          }
        },
        "toolsets": {
          "type": "object",
          "additionalProperties": false,
          "required": ["include"],
          "properties": {
            "include": {
              "type": "array",
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/name" }
            }
          }
        },
        "authorization_scopes_max": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "data_classification_max": { "type": "string", "minLength": 1 }
      }
    },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent", "version", "role", "required"],
      "properties": {
        "agent": { "$ref": "#/$defs/name" },
        "version": { "$ref": "#/$defs/semver" },
        "manifest_id": { "type": "string", "minLength": 1 },
        "role": { "$ref": "#/$defs/name" },
        "required": { "type": "boolean" },
        "restrictions": { "$ref": "#/$defs/restrictions" }
      }
    },
    "interaction": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "from",
        "to",
        "mode",
        "input_schema",
        "output_schema",
        "policy",
        "max_calls",
        "timeout_seconds"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/name" },
        "from": { "$ref": "#/$defs/name" },
        "to": { "$ref": "#/$defs/name" },
        "mode": {
          "enum": ["delegate", "handoff", "review", "fanout", "vote", "dispatch"]
        },
        "input_schema": { "type": "string", "minLength": 1 },
        "output_schema": { "type": "string", "minLength": 1 },
        "policy": { "type": "string", "minLength": 1 },
        "max_calls": { "type": "integer", "minimum": 1 },
        "timeout_seconds": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "max_agent_runs",
        "max_delegation_depth",
        "max_parallel_agents",
        "max_rounds",
        "max_model_requests",
        "max_tool_calls",
        "max_input_tokens",
        "max_output_tokens",
        "max_cost_usd",
        "deadline_seconds"
      ],
      "properties": {
        "max_agent_runs": { "type": "integer", "minimum": 1 },
        "max_delegation_depth": { "type": "integer", "minimum": 0 },
        "max_parallel_agents": { "type": "integer", "minimum": 1 },
        "max_rounds": { "type": "integer", "minimum": 1 },
        "max_model_requests": { "type": "integer", "minimum": 1 },
        "max_tool_calls": { "type": "integer", "minimum": 1 },
        "max_input_tokens": { "type": "integer", "minimum": 1 },
        "max_output_tokens": { "type": "integer", "minimum": 1 },
        "max_cost_usd": { "type": "number", "exclusiveMinimum": 0 },
        "deadline_seconds": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
