{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/X-McKay/playbooks/main/tools/agentctl/src/agentctl/schemas/risk-assessment.schema.json",
  "title": "Agent Risk Assessment",
  "description": "A scenario-based assessment of inherent and residual agent risk.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "assessment",
    "scope",
    "dimension_review",
    "regulatory_screen",
    "classification",
    "scenarios",
    "acceptance",
    "assumptions",
    "open_questions"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "assessment": { "$ref": "#/$defs/assessment" },
    "scope": { "$ref": "#/$defs/scope" },
    "dimension_review": { "$ref": "#/$defs/dimensionReview" },
    "regulatory_screen": { "$ref": "#/$defs/regulatoryScreen" },
    "classification": { "$ref": "#/$defs/classification" },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/scenario" }
    },
    "acceptance": { "$ref": "#/$defs/acceptance" },
    "assumptions": { "$ref": "#/$defs/nonEmptyStrings" },
    "open_questions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "nonEmptyStrings": {
      "type": "array",
      "items": { "$ref": "#/$defs/nonEmptyString" }
    },
    "semanticVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "tier": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"]
    },
    "dimension": {
      "type": "string",
      "enum": [
        "financial",
        "operational",
        "reputational",
        "legal",
        "security",
        "privacy",
        "regulatory",
        "human_impact_safety"
      ]
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent",
        "agent_version",
        "assessment_version",
        "status",
        "assessed_at",
        "review_by",
        "prepared_by",
        "approved_by"
      ],
      "properties": {
        "agent": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "agent_version": { "$ref": "#/$defs/semanticVersion" },
        "assessment_version": { "$ref": "#/$defs/semanticVersion" },
        "status": {
          "type": "string",
          "enum": ["draft", "approved", "rejected", "retired"]
        },
        "assessed_at": { "type": "string", "format": "date" },
        "review_by": { "type": "string", "format": "date" },
        "prepared_by": { "$ref": "#/$defs/nonEmptyString" },
        "approved_by": { "$ref": "#/$defs/nonEmptyStrings" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "approved" } },
            "required": ["status"]
          },
          "then": {
            "properties": { "approved_by": { "minItems": 1 } }
          }
        }
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intended_use",
        "prohibited_uses",
        "users",
        "affected_parties",
        "environments",
        "jurisdictions",
        "execution_class"
      ],
      "properties": {
        "intended_use": { "$ref": "#/$defs/nonEmptyString" },
        "prohibited_uses": { "$ref": "#/$defs/nonEmptyStrings" },
        "users": { "$ref": "#/$defs/nonEmptyStrings" },
        "affected_parties": { "$ref": "#/$defs/nonEmptyStrings" },
        "environments": { "$ref": "#/$defs/nonEmptyStrings" },
        "jurisdictions": { "$ref": "#/$defs/nonEmptyStrings" },
        "execution_class": {
          "type": "string",
          "enum": ["ephemeral", "durable", "human_governed"]
        }
      }
    },
    "dimensionDisposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "rationale"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["applicable", "not_applicable"]
        },
        "rationale": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "dimensionReview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "financial",
        "operational",
        "reputational",
        "legal",
        "security",
        "privacy",
        "regulatory",
        "human_impact_safety"
      ],
      "properties": {
        "financial": { "$ref": "#/$defs/dimensionDisposition" },
        "operational": { "$ref": "#/$defs/dimensionDisposition" },
        "reputational": { "$ref": "#/$defs/dimensionDisposition" },
        "legal": { "$ref": "#/$defs/dimensionDisposition" },
        "security": { "$ref": "#/$defs/dimensionDisposition" },
        "privacy": { "$ref": "#/$defs/dimensionDisposition" },
        "regulatory": { "$ref": "#/$defs/dimensionDisposition" },
        "human_impact_safety": { "$ref": "#/$defs/dimensionDisposition" }
      }
    },
    "governanceFloor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "tier", "rationale"],
      "properties": {
        "source": { "$ref": "#/$defs/nonEmptyString" },
        "tier": { "$ref": "#/$defs/tier" },
        "rationale": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "regulatoryScreen": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prohibited_use",
        "applicable_regimes",
        "required_reviews",
        "governance_floors",
        "notes"
      ],
      "properties": {
        "prohibited_use": { "type": "boolean" },
        "applicable_regimes": { "$ref": "#/$defs/nonEmptyStrings" },
        "required_reviews": { "$ref": "#/$defs/nonEmptyStrings" },
        "governance_floors": {
          "type": "array",
          "items": { "$ref": "#/$defs/governanceFloor" }
        },
        "notes": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "governance_tier",
        "maximum_inherent_tier",
        "maximum_residual_tier",
        "decision",
        "rationale"
      ],
      "properties": {
        "governance_tier": { "$ref": "#/$defs/tier" },
        "maximum_inherent_tier": { "$ref": "#/$defs/tier" },
        "maximum_residual_tier": { "$ref": "#/$defs/tier" },
        "decision": {
          "type": "string",
          "enum": ["go", "conditional_go", "no_go"]
        },
        "rationale": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "rating": {
      "type": "object",
      "additionalProperties": false,
      "required": ["impact", "likelihood", "tier", "confidence", "rationale"],
      "properties": {
        "impact": { "type": "integer", "minimum": 1, "maximum": 4 },
        "likelihood": { "type": "integer", "minimum": 1, "maximum": 4 },
        "tier": { "$ref": "#/$defs/tier" },
        "confidence": {
          "type": "string",
          "enum": ["low", "medium", "high"]
        },
        "rationale": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "description",
        "owner",
        "evidence",
        "effectiveness"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^CTRL-[A-Z0-9-]+$" },
        "type": {
          "type": "string",
          "enum": ["preventive", "detective", "recovery"]
        },
        "description": { "$ref": "#/$defs/nonEmptyString" },
        "owner": { "$ref": "#/$defs/nonEmptyString" },
        "evidence": { "$ref": "#/$defs/nonEmptyStrings" },
        "effectiveness": {
          "type": "string",
          "enum": ["planned", "implemented", "verified", "ineffective"]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "effectiveness": { "const": "verified" } },
            "required": ["effectiveness"]
          },
          "then": {
            "properties": { "evidence": { "minItems": 1 } }
          }
        }
      ]
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "status",
        "statement",
        "primary_dimension",
        "secondary_dimensions",
        "affected_parties",
        "affected_assets",
        "causes",
        "preconditions",
        "consequences",
        "inherent",
        "controls",
        "residual",
        "treatment",
        "owner",
        "eval_cases",
        "indicators",
        "alerts",
        "runbook"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^RISK-[A-Z0-9-]+$" },
        "title": { "$ref": "#/$defs/nonEmptyString" },
        "status": { "$ref": "#/$defs/nonEmptyString" },
        "statement": { "$ref": "#/$defs/nonEmptyString" },
        "primary_dimension": { "$ref": "#/$defs/dimension" },
        "secondary_dimensions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/dimension" }
        },
        "affected_parties": { "$ref": "#/$defs/nonEmptyStrings" },
        "affected_assets": { "$ref": "#/$defs/nonEmptyStrings" },
        "causes": { "$ref": "#/$defs/nonEmptyStrings" },
        "preconditions": { "$ref": "#/$defs/nonEmptyStrings" },
        "consequences": { "$ref": "#/$defs/nonEmptyStrings" },
        "inherent": { "$ref": "#/$defs/rating" },
        "controls": {
          "type": "array",
          "items": { "$ref": "#/$defs/control" }
        },
        "residual": { "$ref": "#/$defs/rating" },
        "treatment": {
          "type": "string",
          "enum": ["avoid", "mitigate", "transfer", "accept"]
        },
        "owner": { "$ref": "#/$defs/nonEmptyString" },
        "eval_cases": { "$ref": "#/$defs/nonEmptyStrings" },
        "indicators": { "$ref": "#/$defs/nonEmptyStrings" },
        "alerts": { "$ref": "#/$defs/nonEmptyStrings" },
        "runbook": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "requirement", "owner", "due_by"],
      "properties": {
        "id": { "type": "string", "pattern": "^CONDITION-[A-Z0-9-]+$" },
        "requirement": { "$ref": "#/$defs/nonEmptyString" },
        "owner": { "$ref": "#/$defs/nonEmptyString" },
        "due_by": { "type": "string", "format": "date" }
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accountable_role",
        "accepted_scenarios",
        "conditions",
        "expires_at",
        "rationale"
      ],
      "properties": {
        "accountable_role": { "$ref": "#/$defs/nonEmptyString" },
        "accepted_scenarios": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^RISK-[A-Z0-9-]+$" }
        },
        "conditions": {
          "type": "array",
          "items": { "$ref": "#/$defs/condition" }
        },
        "expires_at": { "type": "string", "format": "date" },
        "rationale": { "$ref": "#/$defs/nonEmptyString" }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "classification": {
            "properties": { "decision": { "const": "conditional_go" } },
            "required": ["decision"]
          }
        }
      },
      "then": {
        "properties": {
          "acceptance": {
            "properties": { "conditions": { "minItems": 1 } }
          }
        }
      }
    }
  ]
}
