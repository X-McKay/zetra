{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "zetra.dev/v1alpha1"
    },
    "kind": {
      "const": "Agent"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "owner",
        "businessFunction"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,47}$"
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "businessFunction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entrypoint",
        "capabilities",
        "dataClassification",
        "autonomy",
        "execution",
        "budgets"
      ],
      "properties": {
        "entrypoint": {
          "type": "string",
          "pattern": "^[a-zA-Z_]\\w*(?:\\.[a-zA-Z_]\\w*)*:[a-zA-Z_]\\w*$"
        },
        "capabilities": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*\\.[a-z][a-z0-9_-]*$"
          }
        },
        "dataClassification": {
          "enum": [
            "public",
            "internal",
            "confidential",
            "restricted",
            "unknown"
          ]
        },
        "autonomy": {
          "enum": [
            "assist",
            "supervised",
            "autonomous",
            "unknown"
          ]
        },
        "execution": {
          "enum": [
            "local",
            "temporal"
          ]
        },
        "budgets": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "maxSteps",
            "maxSeconds",
            "maxCostUsd"
          ],
          "properties": {
            "maxSteps": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            },
            "maxSeconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400
            },
            "maxCostUsd": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 10000
            }
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zetra.dev/schemas/agent-v1alpha1.json",
  "title": "Zetra Agent v1alpha1"
}
