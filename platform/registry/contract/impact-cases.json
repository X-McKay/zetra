        "inputSchema": {"type": "object"},
        "outputSchema": null
      }
    ]
  },
  "users": [
    {"agent": "db-admin", "authority": "registry", "current": ["execute_sql"], "newest": null},
    {"agent": "sql-helper", "authority": "pull-request", "current": ["execute_sql", "explain_query"], "newest": null},
    {"agent": "upgrading", "authority": "registry", "current": ["execute_sql"],
     "newest": {"phase": "awaiting-runtime", "tools": ["execute_sql", "explain_query"]}},
    {"agent": "was-refused", "authority": "registry", "current": ["execute_sql"],
