{
  "about": "Evaluation suites for delivery.md section 1.3. The registry and the tooling each check a suite; both must accept every `valid` suite and refuse every `invalid` one with a message that contains `mentions`.",
  "valid": [
    {
      "name": "smallest",
      "suite": {
        "schema_version": 1,
        "timeout_seconds": 600,
        "acceptance": {"min_passed": "all"},
        "cases": [{"id": "one", "task": "Say hello."}]
      }
    },
    {
      "name": "every-check",
      "suite": {
        "schema_version": 1,
        "timeout_seconds": 30,
        "acceptance": {"min_passed": 1},
        "cases": [
          {
            "id": "instance-summary",
            "task": "Report the server version and the number of databases.",
            "expect": {
              "outcome": "completed",
              "report_contains": ["PostgreSQL"],
              "report_matches": ["databases?:\\s+\\d+"],
              "report_excludes": ["Traceback"]
            }
          },
          {"id": "second-2", "task": "A second task.", "expect": {}}
        ]
      }
    },
    {
      "name": "longest-timeout",
      "suite": {
        "schema_version": 1,
        "timeout_seconds": 3600,
        "acceptance": {"min_passed": 2},
        "cases": [{"id": "a", "task": "x"}, {"id": "b", "task": "y"}]
      }
    }
  ],
  "invalid": [
    {
      "name": "wrong-schema-version",
      "mentions": "schema_version",
      "suite": {"schema_version": 2, "timeout_seconds": 600, "acceptance": {"min_passed": "all"}, "cases": [{"id": "one", "task": "x"}]}
    },
    {
      "name": "no-cases",
      "mentions": "cases",
      "suite": {"schema_version": 1, "timeout_seconds": 600, "acceptance": {"min_passed": "all"}, "cases": []}
    },
    {
      "name": "timeout-too-short",
      "mentions": "timeout_seconds",
      "suite": {"schema_version": 1, "timeout_seconds": 29, "acceptance": {"min_passed": "all"}, "cases": [{"id": "one", "task": "x"}]}
    },
    {
      "name": "timeout-too-long",
      "mentions": "timeout_seconds",
      "suite": {"schema_version": 1, "timeout_seconds": 3601, "acceptance": {"min_passed": "all"}, "cases": [{"id": "one", "task": "x"}]}
    },
    {
      "name": "timeout-missing",
      "mentions": "timeout_seconds",
      "suite": {"schema_version": 1, "acceptance": {"min_passed": "all"}, "cases": [{"id": "one", "task": "x"}]}
    },
    {
      "name": "acceptance-missing",
      "mentions": "acceptance",
      "suite": {"schema_version": 1, "timeout_seconds": 600, "cases": [{"id": "one", "task": "x"}]}
    },
    {
      "name": "min-passed-above-cases",
      "mentions": "min_passed",
