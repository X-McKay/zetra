    },
    {
      "name": "min-passed-true",
      "mentions": "min_passed",
      "suite": {"schema_version": 1, "timeout_seconds": 600, "acceptance": {"min_passed": true}, "cases": [{"id": "one", "task": "x"}]}
    },
    {
