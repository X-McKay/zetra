"""@@DESCRIPTION@@

`create_agent` returns the tools the model may call. This agent starts with the one most
agents end with, a bounded report written to the workspace. A tool is an async function
with a docstring (the description the model sees) and string arguments, wrapped in
`Tool(fn, effect)`. A tool that reads outside the sandbox calls `ctx.mcp` and nothing
else, is declared `remote_read`, and needs the MCP tool it calls granted in
deploy/agent.yaml under capabilities.mcp:

    evidence = Evidence(ctx.workspace)

    async def list_pods() -> dict:
        '''List the pods in the demonstration namespace.'''
        result = await ctx.mcp("kubernetes", "pods_list_in_namespace", {"namespace": "demo"})
        return evidence.record("pods", {"tool": result["tool"], "text": result["text"]})

    return {"tools": [Tool(list_pods, "remote_read"), report_tool(ctx.workspace, evidence)]}

After changing the tools, `just render` rewrites the `tools:` list in agent.yaml.
"""

from agent_runtime.report import report_tool


def create_agent(ctx) -> dict:
    return {"tools": [report_tool(ctx.workspace)]}
