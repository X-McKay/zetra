# Rendered by `zetra-agents render`; do not edit.
name: CI
on:
  push:
    branches: [main]
  pull_request:
  workflow_dispatch:
permissions:
  contents: read
env:
  UV_VERSION: "0.13.1"
  PYTHON_VERSION: "3.12.14"
jobs:
  repository:
    runs-on: ubuntu-latest
    outputs:
      agents: ${{ steps.list.outputs.agents }}
    steps:
      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
        with:
          persist-credentials: false
      - uses: astral-sh/setup-uv@94527f2e458b27549849d47d273a16bec83a01e9
        with:
          version: ${{ env.UV_VERSION }}
          python-version: ${{ env.PYTHON_VERSION }}
      - run: uv sync --locked
      - run: uv run --locked ruff check .
      - run: uv run --locked ruff format --check .
      - run: uv run --locked zetra-agents check
      - run: uv run --locked zetra-agents render --check
      - id: list
        run: echo "agents=$(uv run --locked zetra-agents list)" >> "$GITHUB_OUTPUT"

  agent:
    needs: repository
    runs-on: ubuntu-latest
    strategy:
      fail-fast: false
      matrix:
        agent: ${{ fromJSON(needs.repository.outputs.agents) }}
    env:
      AGENT: ${{ matrix.agent }}
    steps:
      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
        with:
          persist-credentials: false
      - uses: astral-sh/setup-uv@94527f2e458b27549849d47d273a16bec83a01e9
        with:
          version: ${{ env.UV_VERSION }}
          python-version: ${{ env.PYTHON_VERSION }}
      - run: uv sync --locked --package "zetra-agent-$AGENT"
      - run: uv run --locked pytest -q "agents/$AGENT"
      - name: Build the image (not pushed)
        run: |
          target=$(uv run --locked zetra-agents image-target "$AGENT")
          docker build --platform linux/amd64 --build-arg "AGENT=$AGENT" --target "$target" -t "agent-$AGENT:ci" .
      - name: The image's tools match its manifest
        run: |
          docker run --rm --read-only --user 1500:1500 --network none \
            --tmpfs /sandbox --tmpfs /tmp -e AGENT_SANDBOX_DIR=/sandbox \
            --entrypoint /app/.venv/bin/python "agent-$AGENT:ci" \
            -c "from agent_runtime import step; print(sorted(step.build_agent(step.load_manifest())[1]))"
