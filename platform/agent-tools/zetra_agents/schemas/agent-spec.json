{
  "type": "object",
  "required": [
    "owner",
    "identity",
    "capabilities"
  ],
  "properties": {
    "owner": {
      "type": "string",
      "format": "email"
    },
    "description": {
      "type": "string",
      "maxLength": 512
    },
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "identity": {
      "type": "object",
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "agent",
            "on-behalf-of"
          ]
        },
        "onBehalfOf": {
          "type": "object",
          "properties": {
            "required": {
              "type": "boolean",
              "default": true
            },
            "fallback": {
              "type": "string",
              "enum": [
                "deny",
                "agent"
              ],
              "default": "deny"
            }
          }
        }
      }
    },
    "capabilities": {
      "type": "object",
      "properties": {
        "models": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "backend",
              "models"
            ],
            "properties": {
              "backend": {
                "type": "string",
                "pattern": "^[a-z0-9-]{1,63}$"
              },
              "models": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "budget": {
                "type": "object",
                "properties": {
                  "tokensPerDay": {
                    "type": "integer",
                    "minimum": 1,
                    "default": 2000000
                  },
                  "tokensPerSession": {
                    "type": "integer",
                    "minimum": 1,
                    "default": 200000
                  }
                }
              }
            }
          }
        },
        "mcp": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "backend",
              "effect",
              "tools"
            ],
            "properties": {
              "backend": {
                "type": "string",
                "pattern": "^[a-z0-9-]{1,63}$"
              },
              "effect": {
                "type": "string",
                "enum": [
                  "remote_read"
                ]
              },
              "tools": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.-]{1,128}$"
                }
              },
              "delegation": {
                "type": "string",
                "enum": [
                  "inherit",
                  "agent",
                  "on-behalf-of"
                ],
                "default": "inherit"
              }
            }
          }
        }
      }
    },
    "runtime": {
      "type": "object",
      "properties": {
        "runtimeClass": {
          "type": "string",
          "default": "kata-qemu-runtime-rs"
        },
        "cpu": {
          "type": "string",
          "default": "1"
        },
        "memory": {
          "type": "string",
          "default": "2Gi"
        },
        "ttlSeconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 28800,
          "default": 1800
        },
        "maxBoundaries": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64,
          "default": 64
        }
      }
    }
  }
}
